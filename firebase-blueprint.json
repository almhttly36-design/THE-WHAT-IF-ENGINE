{
  "entities": {
    "simulations": {
      "title": "Simulation",
      "description": "Counterfactual scenario simulations and forecasts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "language": { "type": "string" },
        "scenario_summary": { "type": "string" },
        "risk_index": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "category": { "type": "string" }
          },
          "required": ["score", "category"]
        },
        "outcomes": {
          "type": "object",
          "properties": {
            "optimistic": { "type": "string" },
            "pessimistic": { "type": "string" }
          },
          "required": ["optimistic", "pessimistic"]
        },
        "temporal_impact": {
          "type": "object",
          "properties": {
            "one_month": { "type": "string" },
            "one_year": { "type": "string" },
            "five_years": { "type": "string" }
          },
          "required": ["one_month", "one_year", "five_years"]
        },
        "contingency_plan": {
          "type": "array",
          "items": { "type": "string" }
        },
        "search_intent_title": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "likes": { "type": "number" }
      },
      "required": ["prompt", "scenario_summary", "createdAt"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /simulations/{simulationId} {\n      allow read, create: if true;\n      allow update, delete: if true;\n    }\n  }\n}"
}
